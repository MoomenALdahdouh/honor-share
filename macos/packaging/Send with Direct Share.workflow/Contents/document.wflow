				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh
APP="/Applications/Direct Share.app"
if [[ ! -d "$APP" ]]; then
  osascript -e 'display alert "Direct Share is not installed" message "Put Direct Share.app in /Applications, then try again."'
  exit 1
fi
if [[ $# -eq 0 ]]; then
  exit 1
fi
open -a "$APP" -- "$@"
</string>
